<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher"
        mc:Ignorable="d"
        Title="DPLMP Launcher" Height="472" Width="762">
    <TabControl>
        <TabItem x:Name="MainTab" Header="Browser" Margin="0,0,0,0">
            <Grid Background="#FFE5E5E5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90*"/>
                    <RowDefinition Height="17*"/>
                </Grid.RowDefinitions>
                <Button x:Name="PlayButton" Content="PLAY" HorizontalAlignment="Center" VerticalAlignment="Center" Height="37" Width="166" IsDefault="True" Grid.Row="1" Click="PlayButton_Click"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="DirectTab" HorizontalAlignment="Center" Header="Direct Connect" VerticalAlignment="Top" Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5">
            <TabItem.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </TabItem.RenderTransform>
            <Grid Background="#FFE5E5E5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90*"/>
                    <RowDefinition Height="17*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.RowSpan="2">
                    <Grid Height="34">
                        <TextBlock HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" Text="Address:" VerticalAlignment="Center"/>
                        <TextBox HorizontalAlignment="Left" Margin="71,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="237" Text="127.0.0.1"/>
                    </Grid>
                    <Grid Height="34">
                        <TextBlock HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" Text="Port:" VerticalAlignment="Center"/>
                        <TextBox HorizontalAlignment="Left" Margin="71,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="99" Text="7126"/>
                    </Grid>
                </StackPanel>
                <Button x:Name="DirectPlayButton" Content="PLAY" HorizontalAlignment="Center" VerticalAlignment="Center" Height="37" Width="166" IsDefault="True" Grid.Row="1"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="SettingsTab" Header="Settings" Margin="0,0,0,0">
            <Grid Background="#FFE5E5E5">
                <StackPanel>
                    <Grid Height="34">
                        <TextBlock HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" Text="Game Executable Path:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GameExePathBox" HorizontalAlignment="Left" Margin="135,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="497" TextChanged="GameExePathBox_TextChanged"/>
                        <Button Content="Browse" HorizontalAlignment="Left" Margin="637,0,0,0" VerticalAlignment="Center" Width="80"/>
                    </Grid>
                    <Grid Height="34">
                        <TextBlock HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" Text="Player Name" VerticalAlignment="Center"/>
                        <TextBox x:Name="PlayerNameBox" HorizontalAlignment="Left" Margin="135,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="237" Text="Unnamed" TextChanged="PlayerNameBox_TextChanged"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem x:Name="DevTab" HorizontalAlignment="Center" Header="Dev Mode" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TabItem.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </TabItem.RenderTransform>
            <Grid Background="#FFE5E5E5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90*"/>
                    <RowDefinition Height="17*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.RowSpan="2">
                    <Grid Height="34">
                        <CheckBox x:Name="DevSPLoop" Content="Story Mode" VerticalAlignment="Center" Checked="DevSPLoop_Changed" Unchecked="DevSPLoop_Changed"/>
                    </Grid>
                    <Grid Height="34">
                        <CheckBox x:Name="DevTraffic" Content="Enable Traffic" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Height="34">
                        <CheckBox x:Name="DevCops" Content="Enable Cops" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Height="34">
                        <RadioButton x:Name="ThenRadioButton" Content="'78 Era" VerticalAlignment="Center" GroupName="EraGroup"/>
                        <RadioButton x:Name="NowRadioButton" Content="'06 Era" VerticalAlignment="Center" Margin="100,0,0,0" GroupName="EraGroup" IsChecked="True"/>
                    </Grid>
                </StackPanel>
                <Button x:Name="DevPlayButton" Content="PLAY" HorizontalAlignment="Center" VerticalAlignment="Center" Height="37" Width="166" IsDefault="True" Grid.Row="1" Click="DevPlayButton_Click"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
